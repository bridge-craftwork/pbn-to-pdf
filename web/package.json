{
  "name": "pbn-to-pdf-web",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "description": "Render PBN bridge files to PDF in the browser",
  "scripts": {
    "wasm": "../wasm-build.sh --target web --out-dir ../web/src/wasm --no-typescript",
    "dev": "npm run wasm && vite",
    "build": "vite build",
    "build:all": "npm run wasm && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:browser": "node browser-check.mjs"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "playwright-core": "^1.56.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
